{
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [ "id", "name", "age", "loyalty_level", "active", "joined", "contact", 
                  "address", "preferred_store", "purchases", "lifetime_spend"],
    "properties": {
      "id": { "type": "string" },
      "name": { "type": "string" },
      "age": { "type": "integer", "minimum": 0 },
      "loyalty_level": { "type": "string" },
      "active": { "type": "boolean" },
      "joined": { "type": "string", "format": "date" },
      "contact": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email", "phone"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "phone": { "type": "string" }
        }
      },
      "address": {
        "type": "object",
        "additionalProperties": false,
        "required": ["city", "country", "postal_code"],
        "properties": {
          "city": { "type": "string" },
          "country": { "type": "string" },
          "postal_code": { "type": "string" }
        }
      },
      "preferred_store": {
        "type": "object",
        "additionalProperties": false,
        "required": ["brand", "location"],
        "properties": {
          "brand": { "type": "string" },
          "location": { "type": "string" }
        }
      },
      "purchases": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["date", "store", "basket"],
          "properties": {
            "date": { "type": "string", "format": "date" },
            "store": { "type": "string" },
            "basket": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["product", "category", "quantity", "price"],
                "properties": {
                  "product": { "type": "string" },
                  "category": { "type": "string" },
                  "quantity": { "type": "integer", "minimum": 1 },
                  "price": { "type": "number", "minimum": 0 }
                }
              }
            }
          }
        }
      },
      "lifetime_spend": { "type": "number", "minimum": 0 }
    }
  }
}